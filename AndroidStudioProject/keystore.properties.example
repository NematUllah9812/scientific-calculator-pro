# Copy this file to keystore.properties and fill in your own values.
# keystore.properties is gitignored -- never commit a signing key or its password.
#
# Create a key with:
#   keytool -genkeypair -v -keystore release.keystore -alias myalias \
#           -keyalg RSA -keysize 2048 -validity 10950
storeFile=../release.keystore
storePassword=CHANGE_ME
keyAlias=CHANGE_ME
keyPassword=CHANGE_ME
